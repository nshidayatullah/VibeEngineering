# Salin ke /etc/vibeplan-ai.env (sudo install -m 600 -o root -g root ...). JANGAN commit file aslinya.
# Basis URL 9router yang OpenAI-compatible (port lokal 9router di VPS ini).
VIBEPLAN_AI_UPSTREAM=http://127.0.0.1:20128/v1
# API key 9router. Kosongkan jika endpoint lokal 9router tidak butuh key.
VIBEPLAN_AI_KEY=
# Nama model atau combo di 9router yang dipakai untuk klarifikasi.
VIBEPLAN_AI_MODEL=
# Opsional (nilai bawaan):
# VIBEPLAN_AI_PORT=8787
# VIBEPLAN_AI_MAX_TOKENS=1200
# VIBEPLAN_AI_TIMEOUT_MS=40000
# VIBEPLAN_AI_RATE_MINUTE=5
# VIBEPLAN_AI_RATE_DAY=50
# VIBEPLAN_AI_TEMPERATURE=0.2
# Kirim response_format json_object (1 = aktif). Aktifkan hanya jika model di 9router mendukungnya.
# VIBEPLAN_AI_JSON_MODE=0
